<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.swjtu.smec.mapper.FollowupPlanMapper">

    <select id="selectPageByDoctor" resultType="com.swjtu.smec.entity.FollowupPlan">
        SELECT * FROM followup_plan
        <where>
            <if test="doctorId != null">AND doctor_id = #{doctorId}</if>
            <if test="followupType != null">AND followup_type = #{followupType}</if>
            <if test="status != null">AND status = #{status}</if>
            <if test="startDate != null and startDate != ''">AND plan_date >= #{startDate}</if>
            <if test="endDate != null and endDate != ''">AND plan_date &lt;= #{endDate}</if>
        </where>
        ORDER BY status ASC, plan_date ASC
    </select>

</mapper>
