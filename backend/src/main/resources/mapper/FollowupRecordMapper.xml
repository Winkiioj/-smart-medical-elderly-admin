<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.swjtu.smec.mapper.FollowupRecordMapper">

    <select id="selectRecentByElderly" resultType="com.swjtu.smec.entity.FollowupRecord">
        SELECT * FROM followup_record
        WHERE elderly_id = #{elderlyId}
        ORDER BY create_time DESC
        LIMIT #{limit}
    </select>

</mapper>
